{
  "name": "tdyu-endowment",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:next",
    "server": "node server/src/index.mjs",
    "dev:all": "npm run dev:new",
    "dev:next": "npm run dev --prefix web",
    "dev:new": "concurrently -k -n api,next -c cyan,green \"npm run server\" \"npm run dev:next\"",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:forms": "playwright test --project=forms",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:i18n": "playwright test --project=i18n",
    "test:unit": "vitest run",
    "test:migration-safety": "node scripts/test-migration-safety.mjs",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.mjs",
    "build": "npm run build --prefix web",
    "preview": "npm run start --prefix web"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/maitree": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  }
}
